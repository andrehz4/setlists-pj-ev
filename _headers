# Headers do Cloudflare Pages.
#
# font-src inclui 'self': a fonte de notação da tablatura (alphaTab, Bravura) mora em /media/lib/alphatab/font/.
# CSP: 'unsafe-inline' em script/style e obrigatorio (o app e single-file com
# JS/CSS inline); mesmo assim a CSP bloqueia script de QUALQUER dominio
# externo nao listado, object/embed, e form-action fora do site.
# Dominios na connect-src: backend do forum (Railway), GA4, Cloudflare Web Analytics e audio (R2).
# Se um embed novo quebrar, o console do browser mostra a diretiva violada;
# rollback = git revert deste arquivo.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data: blob:; media-src 'self' blob: https://pub-4d99051b225d492fbf4ac3bfdbef7de4.r2.dev; connect-src 'self' https://perpetual-energy-production-1a69.up.railway.app https://cloudflareinsights.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://pub-4d99051b225d492fbf4ac3bfdbef7de4.r2.dev; frame-src 'self' https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Imagens de noticia sao content-addressed (1 arquivo novo por item, nunca
# reescritas): cache longo e seguro e poupa origem.
/media/news/img/*
  Cache-Control: public, max-age=604800

# Letras escritas a mao do gerador de setlist do Ibirapuera: mudam raramente, 1 dia de cache.
/setlist-ibirapuera/img/*
  Cache-Control: public, max-age=86400

# Código e dados do gerador mudam toda hora nesta semana de show: o navegador confere a versão a cada visita
# (ETag, resposta 304 quando não mudou). Sem isso, o celular ficava até 4 h com o app.js velho.
/setlist-ibirapuera/*.js
  Cache-Control: public, max-age=0, must-revalidate
/setlist-ibirapuera/musicas.json
  Cache-Control: public, max-age=0, must-revalidate
/setlist-ibirapuera/
  Cache-Control: public, max-age=0, must-revalidate
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob: https://pub-4d99051b225d492fbf4ac3bfdbef7de4.r2.dev; connect-src 'self' https://perpetual-energy-production-1a69.up.railway.app https://cloudflareinsights.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://pub-4d99051b225d492fbf4ac3bfdbef7de4.r2.dev; frame-src 'self' https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Gerador do Ibirapuera: não usa câmera, microfone, localização, pagamento nem USB. web-share e autoplay ficam livres
# (o story usa o compartilhar do celular e o vídeo do Eddie toca sozinho).
# CSP própria: igual à global, mas imagem só do próprio site (os PNGs oficiais ficam em img/oficial/).
/setlist-ibirapuera/*
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob: https://pub-4d99051b225d492fbf4ac3bfdbef7de4.r2.dev; connect-src 'self' https://perpetual-energy-production-1a69.up.railway.app https://cloudflareinsights.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://pub-4d99051b225d492fbf4ac3bfdbef7de4.r2.dev; frame-src 'self' https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# Páginas de banda cover do gerador de setlist (/setlist/<banda>/): mesma CSP do Ibirapuera (as imagens das músicas
# vêm de /setlist-ibirapuera/img/ e os shows de /media/agenda/shows.json, ambos do próprio site).
/setlist/*
  Cache-Control: public, max-age=0, must-revalidate
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob: https://pub-4d99051b225d492fbf4ac3bfdbef7de4.r2.dev; connect-src 'self' https://perpetual-energy-production-1a69.up.railway.app https://cloudflareinsights.com https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://pub-4d99051b225d492fbf4ac3bfdbef7de4.r2.dev; frame-src 'self' https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

/forum-topic.html
  Permissions-Policy: microphone=(self)

# Painel de colaboradores (colaborar.html + /colab). CSP PROPRIA: troca a global
# (o "!" solta a regra de cima) so nesta pagina, pra liberar o botao do Google
# (accounts.google.com/gsi) e o upload direto pro R2 (*.r2.cloudflarestorage.com).
# Sem 'unsafe-inline' em script: a pagina so carrega modulos de /colab.
/colaborar
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src https://fonts.gstatic.com; img-src 'self' https: data: blob:; media-src 'self' blob: https://*.r2.cloudflarestorage.com; connect-src 'self' https://perpetual-energy-production-1a69.up.railway.app https://*.r2.cloudflarestorage.com https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Robots-Tag: noindex

