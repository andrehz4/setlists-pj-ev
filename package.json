{
  "name": "setlists-pj-ev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Arquivo fan-to-fan de shows Pearl Jam + Eddie Vedder (BR)",
  "scripts": {
    "dev": "node scripts/_devserver.mjs",
    "news:fetch": "node scripts/news/fetch-news.mjs",
    "news:dry": "node scripts/news/fetch-news.mjs --dry-run",
    "news:fixtures": "node scripts/news/fetch-news.mjs --fixtures --dry-run",
    "publish:dry": "node scripts/publish/run-publish.mjs --dry-run --no-git",
    "publish:run": "node scripts/publish/run-publish.mjs",
    "publish:refresh": "node scripts/publish/refresh-token.mjs",
    "publish:seed": "node scripts/publish/seed-queue.mjs",
    "publish:smoke": "node scripts/publish/smoke-test.mjs",
    "publish:story:dry": "node scripts/publish/run-publish-story.mjs --dry-run --no-git",
    "publish:story": "node scripts/publish/run-publish-story.mjs",
    "mock:server": "node mock-ig/server.mjs",
    "mock:reset": "node mock-ig/reset.mjs",
    "mock:seed": "node scripts/publish/seed-queue.mjs --count=6",
    "mock:publish": "node mock-ig/run.mjs feed",
    "mock:story": "node mock-ig/run.mjs story",
    "mock:story:reuse": "node mock-ig/story-mock.mjs",
    "test:cifras": "node --test scripts/cifras-coverage.test.mjs",
    "test:band": "node --test scripts/publish/band-fallback.test.mjs",
    "test:select": "node --test scripts/publish/queue-select.test.mjs",
    "test:mock": "node --test mock-ig/mock.test.mjs",
    "test": "node --test scripts/cifras-coverage.test.mjs scripts/publish/band-fallback.test.mjs scripts/publish/queue-select.test.mjs mock-ig/mock.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@google/generative-ai": "^0.24.1",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "cheerio": "^1.0.0",
    "got": "^14.4.5",
    "rss-parser": "^3.13.0",
    "sharp": "^0.33.5",
    "smartcrop-sharp": "^2.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
