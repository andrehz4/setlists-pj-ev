\title "Black"
\subtitle "Pearl Jam, Ten (1991)"
\artist "Pearl Jam"
\tempo 87
\tuning E4 B3 G3 D3 A2 E2
.
// Progressão básica do tema (Em - G - D - A) em arpejo simplificado.
// Cada compasso = um acorde, 4 grupos de colcheias (:8).
// Nota: AlphaTex usa fret.string, onde string 6 = E grave, string 1 = e aguda.

:8 (0.6 0.5 0.4 0.3 0.2 0.1) (0.6 0.5 0.4 0.3 0.2 0.1) (2.5 0.4 0.3 0.2) (0.6 0.5 0.4) |
:8 (3.6 2.5 0.4 0.3 0.2 3.1) (3.6 2.5 0.4 0.3 0.2 3.1) (0.4 0.3 0.2 3.1) (3.6 2.5 0.4) |
:8 (0.4 2.3 3.2 2.1) (0.4 2.3 3.2 2.1) (0.4 2.3 3.2) (0.4 2.3 3.2 2.1) |
:8 (0.5 2.4 2.3 2.2 0.1) (0.5 2.4 2.3 2.2 0.1) (0.5 2.4 2.3) (0.5 2.4 2.3 2.2 0.1) |
